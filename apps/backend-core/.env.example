# Cấu hình môi trường cho ứng dụng
PORT=5000
DB_HOST=127.0.0.1
DB_USER=
DB_PASSWORD=
DB_NAME=backend_core
JWT_SECRET=

# Cấu hình Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cấu hình Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Cấu hình cơ sở dữ liệu
DATABASE_URL=postgresql://postgres:rootpassword@127.0.0.1:5432/ecom_crm?schema=public

# Cấu hình Redis (dùng cho BullMQ)
REDIS_URL=redis://127.0.0.1:6379

# Cấu hình AWS S3 (Lưu trữ file riêng tư)
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=

# Cấu hình Stripe (Thanh toán quốc tế)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cấu hình VNPay (Thanh toán nội địa)
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:5000/api/payment/vnpay-return
